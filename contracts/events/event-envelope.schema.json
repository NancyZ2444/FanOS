{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanos.local/contracts/events/event-envelope.schema.json",
  "title": "Fan OS domain event envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "aggregate",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 120 },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 60 },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 60 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "trace_id": { "type": ["string", "null"], "maxLength": 64 },
    "payload": { "type": "object" }
  }
}
