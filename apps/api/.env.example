ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fan_os:fan_os_dev@localhost:5432/fan_os
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
DEV_PHONE_CODE=123456
AUTO_SEED=true

STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=./data/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# Existing cached portraits remain usable. Enable remote fetches only after source setup.
CATALOG_REMOTE_PORTRAITS_ENABLED=false
CATALOG_IMAGE_HOSTS=["upload.wikimedia.org"]
CATALOG_IMAGE_USER_AGENT=FanOS-CatalogThumbnail/1.0

# S3 / MinIO production-compatible alternative
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=fan_os_minio
S3_SECRET_KEY=fan_os_minio_secret
S3_BUCKET=fan-os-media
S3_REGION=us-east-1

# Supplied card-matcher. Three bundled ONNX features can run in real mode.
CARD_MATCHER_FACE=mock
# Enable only after installing .[ai-face] and provisioning buffalo_l offline.
# CARD_MATCHER_INSIGHTFACE_ROOT=/absolute/path/to/.insightface
CARD_MATCHER_BODY=real
CARD_MATCHER_EXPRESSION=real
CARD_MATCHER_POSE=real
CARD_MATCHER_INDEX_PATH=./data/card_matcher/cards.json
WORKER_TOKEN=fan-os-dev-worker-token
